{
  "version": 2,
  "installCommand": "npm install",
  "builds": [
    {
      "src": "src/vercel.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/src/vercel.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/process-notifications",
      "schedule": "0 * * * *"
    }
  ]
}
